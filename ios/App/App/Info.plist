<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Mezmur</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Custom URL scheme for deep links — a share link's landing page
	     (server/src/routes/share.ts) opens mezmur://artist/<id> to jump
	     straight into the app on a device that already has it installed,
	     handled by the appUrlOpen listener in src/App.tsx. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mezmur</string>
			</array>
		</dict>
	</array>
	<!--
	  Blanket cleartext (plain HTTP) allowance, not scoped to one IP — the
	  app loads over https://localhost (Capacitor's WebView origin), which
	  iOS blocks plain-HTTP requests from by default (App Transport
	  Security). This app talks to whatever Mac IP VITE_API_URL was built
	  with (see .env.production.local), and that IP has already changed
	  twice in one session (different WiFi, hotspot) — a scoped exception
	  domain meant re-editing this file and rebuilding the native app every
	  time the network changed, which is exactly what caused a real "login
	  crashing" report when the old scoped IP went stale. This build is
	  debug-only and never distributed, so NSAllowsArbitraryLoads is an
	  acceptable, pragmatic tradeoff here — a real release build would need
	  proper HTTPS instead.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<!-- iOS 27 turned "no Scene lifecycle adoption" from a logged
		     runtime warning into a hard EXC_BREAKPOINT crash on launch
		     (seen live on an iPhone 18 Pro Max running 27.0.1 — the app
		     crashed instantly, before any UI, while the same build ran
		     fine on older iOS). This app otherwise still uses the plain
		     AppDelegate + Main storyboard setup below, completely
		     unchanged - SceneDelegate.swift just re-points that same
		     storyboard through the Scene lifecycle UIKit now requires. -->
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
