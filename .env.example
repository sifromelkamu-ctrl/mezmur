# Base URL of the backend API (see server/.env for the server's own config).
VITE_API_URL=http://localhost:3001/api

# Supabase project URL and publishable (client-safe) key. Never put the
# secret/service-role key here — this file is bundled into client code.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
