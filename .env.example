# Base URL of the backend API (see server/.env for the server's own config).
VITE_API_URL=http://localhost:3001/api

# Supabase project URL and publishable (client-safe) key. Never put the
# secret/service-role key here — this file is bundled into client code.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional: Cloudflare R2's public media base URL (see src/lib/bibleAudio.ts
# and server/.env.example's R2_MEDIA_DOMAIN) — safe to expose, it's a public,
# read-only bucket with nothing sensitive behind it. Only used for Bible
# audio's client-built URLs; leave unset and it keeps building the old
# Supabase URL. Never put R2 access keys here — this file is bundled into
# client code, same rule as the Supabase key above.
VITE_R2_MEDIA_DOMAIN=
