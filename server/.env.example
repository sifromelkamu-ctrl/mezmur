# PostgreSQL connection string for the Supabase project's database.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Port the Express API listens on.
PORT=3001

# Supabase project URL and keys. SUPABASE_SECRET_KEY bypasses Row Level
# Security and must never be exposed to the client or committed anywhere.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# Optional. Powers intelligent album artwork matching (server/src/artwork) —
# a free Client Credentials app from https://developer.spotify.com/dashboard.
# Entirely optional: artwork matching is skipped (falling back to the
# existing YouTube-thumbnail-derived cover) whenever these are unset.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional. A real YouTube account's cookies.txt (Netscape format),
# base64-encoded — without it, YouTube's bot-check ("Sign in to confirm
# you're not a bot") blocks virtually all datacenter/cloud IPs on every
# download, though it's usually fine from a home/residential IP (most local
# dev). Export via a browser extension like "Get cookies.txt LOCALLY" while
# logged into YouTube, then: base64 -i cookies.txt | tr -d '\n'
YTDLP_COOKIES_B64=

# Optional. Routes yt-dlp through a residential/ISP proxy (NOT a datacenter
# proxy — that just swaps one flagged IP for another). Needed if cookies
# alone aren't enough: YouTube's bot-check can still block lower-traffic
# channel content from a datacenter IP even with valid cookies. Format:
# http://user:pass@host:port or socks5://user:pass@host:port, from your
# proxy provider. Not needed for local dev from a home IP.
YTDLP_PROXY_URL=

# Optional. Telegram channel import — MTProto (teleproto/GramJS) user-session
# credentials, so the server can read a public channel's existing message
# history the same way any "download from Telegram channel" tool does (the
# official Bot API can't: a bot only sees messages posted after it joins).
# 1. Get api_id/api_hash (free) from https://my.telegram.org/apps
# 2. Run `cd server && npx tsx scripts/telegramLogin.ts` locally once — it
#    walks through phone number + login code (+ 2FA password if you have one
#    set) and prints a reusable session string for TELEGRAM_SESSION below.
# This is your own Telegram account making the requests — heavy use carries
# a rate-limit/flood-wait risk on that account, so keep imports reasonably
# paced (the worker already does this automatically).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Web Push (daily Bible verse notification). Generate a keypair once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# and keep it stable — rotating it breaks every existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Public base URL of the deployed frontend — the daily push job fetches the
# actual verse text from its public Bible JSON at send time.
FRONTEND_URL=https://your-app.vercel.app
# UTC hour the daily verse push fires (6 = 9am Addis Ababa time, UTC+3).
DAILY_VERSE_PUSH_HOUR_UTC=6

# Subscriptions — Stripe Checkout + Billing Portal for the paid tier (full
# catalog access after the 30-day free trial). Playback stays limited to
# short previews for signed-in users past their trial with no active
# subscription whenever these are unset; nothing else in the app requires
# them. From your Stripe dashboard:
#   1. Create a recurring Product/Price (e.g. $3.99/month) and copy its
#      price id (starts with "price_") into STRIPE_PRICE_ID below.
#   2. Copy the secret key (Developers -> API keys) into STRIPE_SECRET_KEY.
#   3. Add an endpoint for https://<your-api>/api/webhooks/stripe listening
#      for customer.subscription.created/updated/deleted (Developers ->
#      Webhooks), then copy its signing secret into STRIPE_WEBHOOK_SECRET.
#      For local dev, `stripe listen --forward-to localhost:3001/api/webhooks/stripe`
#      prints a signing secret you can use instead.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Amharic audio Bible — streamed live from Faith Comes By Hearing's Digital
# Bible Platform ("Bible Brain") API, never downloaded/stored server-side.
# Register a developer account at https://www.faithcomesbyhearing.com/bible-brain
# to get a key; confirm your account has access to the fileset below (some
# filesets need FCBH's direct approval, not just any API key).
DBP_API_KEY=
DBP_AUDIO_FILESET_ID=AMH1954A1DA
