generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  artist
  admin
}

// Mirrors a Stripe Subscription's own status field (the ones relevant to
// gating playback) — kept in sync by the Stripe webhook, never written to
// directly from any other request handler. The one exception is `comped`:
// an admin-granted free-access override (see routes/admin.ts's
// /users/:id/free-access) with no Stripe object behind it at all, so the
// webhook can never see or overwrite it — it only ever matches profiles by
// stripeCustomerId, which a comped-only profile never has.
enum SubscriptionStatus {
  none // never subscribed — trial-or-preview gating applies
  trialing
  active
  past_due
  canceled
  comped
}

// Mirrors Supabase Auth's auth.users table (id is the same UUID as the
// Supabase-managed user). The FK constraint to auth.users and the trigger
// that keeps this table populated on signup live in a hand-written migration
// (Prisma's schema DSL can't express cross-schema FKs or triggers).
model Profile {
  id                    String                @id @db.Uuid
  // Nullable: a phone-only signup has no email, and vice versa — exactly one
  // of email/phone is guaranteed to be set by the app, never both null.
  email                 String?               @unique
  phone                 String?               @unique
  // Case-insensitive uniqueness is enforced by a functional index on
  // lower(username) in the migration (no citext extension needed); always
  // query/compare usernames via lower() from application code.
  username              String?
  name                  String?
  avatarUrl             String?
  bio                   String?
  country               String?
  preferredLanguage     String                @default("en")
  lastLoginAt           DateTime?
  role                  Role                  @default(user)
  createdAt             DateTime              @default(now())

  // 30-day free-full-access window from signup — set once by the DB default
  // below, never extended by application code today (a manual dashboard/SQL
  // edit is the only current way to comp someone extra trial time). After
  // this passes with no active subscription, playback is limited to
  // short previews (see PlayerContext.tsx).
  trialEndsAt           DateTime              @default(dbgenerated("(now() + interval '30 days')"))
  subscriptionStatus    SubscriptionStatus    @default(none)
  // Null until the user's first checkout attempt creates a Stripe customer
  // (kept even after a subscription lapses, so a returning customer reuses
  // the same Stripe customer record instead of accumulating duplicates).
  stripeCustomerId      String?               @unique
  stripeSubscriptionId  String?               @unique
  // End of the current paid billing period — while subscriptionStatus is
  // "active" this is when it next renews; while "canceled" (but not yet
  // expired) this is when access actually ends, since Stripe keeps a
  // canceled subscription active through the period already paid for.
  subscriptionCurrentPeriodEnd DateTime?

  artists               Artist[]
  playlists             Playlist[]
  auditLogs             AuditLog[]
  importBatches         YoutubeImportBatch[]
  telegramImportBatches TelegramImportBatch[]
  pushSubscriptions     PushSubscription[]
  contactMessages       ContactMessage[]
  songSubmissions       SongSubmission[]

  @@map("profiles")
}

// One row per browser/device the user has enabled daily-verse push
// notifications on (a user can have several — phone + desktop, etc.).
// endpoint is the Push API's own unique subscription URL, so it doubles as
// the natural dedupe key (re-subscribing the same device just updates keys).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  profile   Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String   @db.Uuid
  admin     Profile  @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@map("audit_logs")
}

enum ContactMessageStatus {
  new
  read
}

// Settings > Contact Us submissions. userId is nullable — the form takes a
// reply-to email directly rather than requiring login, so a prospective
// user with a question before signing up can still reach out; onDelete:
// SetNull keeps the message on record (orphaned, not deleted) if the
// account it came from is ever removed.
// The thread/conversation itself — subject line, original sender info, and
// whatever the very first message said. Every message after the first
// (either side) lives in ContactMessageReply instead; see that model for
// why the first message isn't stored there too.
model ContactMessage {
  id        String               @id @default(cuid())
  userId    String?              @db.Uuid
  profile   Profile?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String?
  email     String
  subject   String
  message   String
  // Optional screenshot/file, uploaded to the "contact-attachments"
  // Supabase Storage bucket the same way artist/album art already is (see
  // uploadImageToStorage) — this column just holds the resulting public URL.
  // Reply-level attachments aren't supported (yet) — keeping the composer
  // for an ongoing conversation to plain text is a deliberate scope call,
  // not an oversight.
  attachmentUrl String?
  status    ContactMessageStatus @default(new)
  createdAt DateTime             @default(now())
  replies   ContactMessageReply[]

  @@index([userId])
  @@map("contact_messages")
}

enum ContactMessageSender {
  user
  admin
}

// One row per message after a thread's first (see ContactMessage.message
// for that one) — this is what turns Contact Us from "one message, one
// reply" into a real back-and-forth conversation, either side can keep
// adding to. Kept as a child table rather than folding the first message
// in here too, so ContactMessage stays a single, editable-free-and-clear
// row for the thread's own metadata (subject/status/sender identity), with
// no ambiguity about which reply — if any — was "the real first message."
model ContactMessageReply {
  id        String               @id @default(cuid())
  messageId String
  message   ContactMessage       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  sender    ContactMessageSender
  body      String
  createdAt DateTime             @default(now())

  @@index([messageId])
  @@map("contact_message_replies")
}

enum SongSubmissionType {
  single
  album
}

enum SongSubmissionStatus {
  pending
  approved
  rejected
}

// Settings > Upload Your Songs. A regular (non-admin) user submits a single
// or an album — with its own artist/album art and one or more tracks — for
// admin review. Nothing here touches the real catalog (Artist/Album/Track)
// until an admin approves it (see routes/admin.ts's
// /submissions/:id/approve), so a submission sitting at "pending" or
// "rejected" is never visible anywhere a listener would see it.
model SongSubmission {
  id         String             @id @default(cuid())
  userId     String             @db.Uuid
  profile    Profile            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       SongSubmissionType
  artistName String
  // Album-only (see routes/submissions.ts's zod schema — a single never sets
  // these). On approval, findOrCreateArtist only actually uses this when it
  // ends up creating a brand-new artist; an existing catalog artist matched
  // by name keeps whatever photo it already has.
  artistPhotoUrl String?
  albumTitle     String?
  albumCoverUrl  String?
  // Optional free-text note from the submitter to the admin (e.g. "this is
  // a re-upload with fixed audio", "please credit as 'ft.'") — shown in the
  // admin review queue, distinct from reviewNote below which flows the
  // other direction (admin back to submitter).
  submitterNote  String?
  status         SongSubmissionStatus @default(pending)
  reviewNote     String?
  reviewedAt     DateTime?
  // Set once approved, so the admin inbox can link straight to what got
  // created instead of the reviewer having to go search for it by name.
  createdArtistId String?
  createdAlbumId  String?
  createdAt       DateTime             @default(now())
  tracks          SongSubmissionTrack[]

  @@index([userId])
  @@index([status])
  @@map("song_submissions")
}

model SongSubmissionTrack {
  id           String         @id @default(cuid())
  submissionId String
  submission   SongSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  title        String
  position     Int
  audioUrl     String
  // Single-only — an approved album track's artwork always mirrors its
  // album's cover ("Album Artwork Is Master Artwork", same rule the rest of
  // the catalog follows), so only a submitted single ever sets this.
  artworkUrl     String?
  createdTrackId String?
  createdAt      DateTime @default(now())

  @@index([submissionId])
  @@map("song_submission_tracks")
}

model Artist {
  id               String   @id @default(cuid())
  name             String
  bio              String?
  gradientFrom     String
  gradientTo       String
  monthlyListeners Int      @default(0)
  isGroup          Boolean  @default(false)
  photoUrl         String?
  ownerId          String?  @db.Uuid
  owner            Profile? @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  albums           Album[]
  tracks           Track[]
  createdAt        DateTime @default(now())

  // Admin-only artwork framing (pan/zoom/rotate/flip), applied on top of
  // photoUrl at render time — never touches the original image. Null means
  // "no manual edit yet, use the smart-framing default."
  artworkFrame Json?

  // Manual Spotify artist link: the admin-confirmed Spotify artist ID this
  // catalog artist is permanently linked to (see the artist-level "Link to
  // Spotify" workflow). Null means not linked. Catalog syncs pull directly
  // from this ID's Spotify albums — never a name search — so the link can
  // never silently drift to a different artist.
  spotifyId            String?   @unique
  spotifyLastSyncedAt  DateTime? // set on every successful catalog sync
  spotifyLastSyncError String? // set on a failed sync; cleared on the next success, relink, or unlink

  @@index([ownerId])
}

enum AlbumType {
  album
  ep
  single
  live
  compilation
}

model Album {
  id           String    @id @default(cuid())
  title        String
  year         Int?
  gradientFrom String?
  gradientTo   String?
  coverUrl     String?
  description  String?
  albumType    AlbumType @default(album)
  releaseDate  DateTime?
  genre        String?
  artistId     String
  artist       Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tracks       Track[]
  createdAt    DateTime  @default(now())

  // Admin-only artwork framing — see Artist.artworkFrame for the contract.
  artworkFrame Json?

  // Spotify Catalog Sync — see Artist.spotifyId for the caching contract.
  // copyright/recordLabel come from Spotify's per-album copyrights/label
  // fields (only available via the full album lookup, not search results).
  spotifyId   String? @unique
  copyright   String?
  recordLabel String?

  @@index([artistId])
}

model Track {
  id                 String          @id @default(cuid())
  title              String
  duration           Int             @default(0)
  language           String?
  genre              String?
  audioUrl           String?
  coverUrl           String?
  moods              String[]        @default([])
  playCount          Int             @default(0)
  // Nullable — a Single imported from YouTube that doesn't match any
  // existing artist is left unassigned rather than auto-creating a new
  // Artist row (see youtube/pipeline.ts's findExistingArtist). Every other
  // track (regular album/EP/concert tracks, and any Single that does match
  // an existing artist) still always has one, exactly as before.
  artistId           String?
  artist             Artist?         @relation(fields: [artistId], references: [id], onDelete: Cascade)
  // Plain-text fallback for artistName display (Now Playing, track rows,
  // etc.) when artistId is null — never a substitute for a real Artist
  // link, and never read when artist is set.
  artistNameOverride String?
  albumId            String?
  album              Album?          @relation(fields: [albumId], references: [id], onDelete: SetNull)
  trackNumber        Int?
  discNumber         Int?
  playlistTracks     PlaylistTrack[]
  createdAt          DateTime        @default(now())

  // Set only for tracks imported from YouTube (see /api/admin/youtube-import).
  // sourceId is the YouTube video ID and is unique so the same video can
  // never be imported twice.
  sourceUrl   String?
  sourceId    String?   @unique
  publishedAt DateTime?
  waveform    Json?

  // Admin-editable lyrics text (Library Management feature). Nullable —
  // most tracks won't have this set.
  lyrics String? @db.Text

  // True only when this track was imported via "Import from YouTube" with
  // the "Single" destination explicitly chosen (see routes/youtubeImport.ts
  // and routes/singles.ts) — deliberately NOT inferred from albumId being
  // null, since a track can end up without an album for other reasons (an
  // old import from before this flag existed, its album later deleted,
  // etc.) without the admin ever having meant it to appear in the Home
  // Singles section. Mirrors how a Concert Album must be deliberately
  // tagged rather than auto-detected.
  isSingle Boolean @default(false)

  // True only when this track was imported/converted as a standalone
  // "Concert Song" — a Concert destination import of a single YouTube video
  // that isn't attached to any Concert Album (see routes/youtubeImport.ts,
  // routes/concerts.ts). Mutually exclusive with isSingle in practice (never
  // both true at once — see adminLibrary.ts's track-conversion endpoint),
  // and — like isSingle — deliberately a tag, never inferred from albumId
  // being null, so an old orphaned track never accidentally shows up here.
  isConcertSong Boolean @default(false)

  // Admin-only artwork framing — see Artist.artworkFrame for the contract.
  // "Album Artwork Is Master Artwork": for a track with an albumId, this
  // column (and coverUrl above) is never read — toTrackDTO always resolves
  // artwork live from the album instead. Only meaningful for standalone
  // singles (albumId: null), which keep their own.
  artworkFrame Json?

  // Spotify Catalog Sync — see Artist.spotifyId for the caching contract.
  // popularity is Spotify's 0-100 track popularity score, synced verbatim.
  spotifyId  String? @unique
  popularity Int?

  @@index([artistId])
  @@index([albumId])
}

model Playlist {
  id           String          @id @default(cuid())
  title        String
  description  String?
  gradientFrom String
  gradientTo   String
  coverUrl     String?
  ownerId      String?         @db.Uuid
  owner        Profile?        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tracks       PlaylistTrack[]
  createdAt    DateTime        @default(now())

  // Admin-only artwork framing — see Artist.artworkFrame for the contract.
  artworkFrame Json?

  @@index([ownerId])
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  trackId    String
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  position   Int

  @@unique([playlistId, trackId])
  @@index([trackId])
}

model Sermon {
  id           String   @id @default(cuid())
  title        String
  speaker      String
  description  String?
  duration     Int      @default(0)
  gradientFrom String
  gradientTo   String
  createdAt    DateTime @default(now())
}

model Podcast {
  id           String   @id @default(cuid())
  title        String
  host         String
  description  String?
  duration     Int      @default(0)
  gradientFrom String
  gradientTo   String
  createdAt    DateTime @default(now())
}

enum YoutubeImportBatchStatus {
  enumerating
  ready
  importing
  // Admin manually stopped an in-progress batch (see catalogWorker.ts's
  // stopBatch). Items that hadn't started yet are reset to "pending" so the
  // batch behaves exactly like a freshly-enumerated one on the selection
  // screen — the admin can review/reselect and hit "Start Import" again.
  stopped
  completed
  completed_with_errors
  error
}

enum YoutubeImportItemStatus {
  pending // enumerated, not yet selected
  selected // chosen by the admin, queued for processing
  downloading
  processing // waveform generation
  uploading
  saving
  done
  error
  skipped_duplicate
  // Admin manually cancelled this one item (the per-item X button) — either
  // pulled out of the queue before it started, or its in-flight
  // yt-dlp/ffmpeg process was killed mid-download. Distinct from "pending"
  // so the UI can show it was a deliberate action, not "never touched".
  cancelled
}

// One "Import artist catalog" run against a single channel/artist URL. Items
// are enumerated up front (see youtube/catalogEnumerate.ts), the admin picks
// which ones to bring in, then the catalog worker (youtube/catalogWorker.ts)
// processes selected items in the background. Persisting batch/item state in
// the database (rather than in-memory, as the single-video quick-import job
// does) is what makes resuming after a server restart possible: on boot, any
// batch left "importing" gets its unfinished items re-queued.
model YoutubeImportBatch {
  id          String                   @id @default(cuid())
  sourceUrl   String
  channelName String?
  status      YoutubeImportBatchStatus @default(enumerating)
  error       String?
  createdBy   String                   @db.Uuid
  admin       Profile                  @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  items       YoutubeImportItem[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  // Purely cosmetic, admin-editable display name for the Import History
  // list — never read or written by the pipeline itself.
  label String?

  // The artist this whole batch imports into — chosen explicitly by the
  // admin before enumeration starts (never guessed from the channel name).
  // Nullable only so pre-existing batches from before this field existed
  // don't break; every batch created going forward always sets it.
  targetArtistId String?

  // Normalized titles of albums that already existed under targetArtistId
  // at the moment this batch was created — captured once, up front, so
  // "was this album new or already there" (see YoutubeImportItem.albumWasNew)
  // reflects state *before* this import run touched anything, and stays
  // correct even if the batch is interrupted and resumed later.
  existingAlbumTitlesSnapshot Json?

  // "Allow duplicate imports" — off by default (skip anything that already
  // exists, the historical behavior). When on, existing albums/singles/
  // tracks are never reused or modified; everything imports as a brand-new
  // row with its own id instead of being matched/skipped.
  allowDuplicates Boolean @default(false)

  // Only used when allowDuplicates is true: maps a normalized album title to
  // the id of the new duplicate Album created for it *during this batch
  // run*, so all N tracks of one re-imported album land together in one
  // freshly-created duplicate album, rather than each track spawning its own
  // separate one-track album. Read-modify-write is safe without locking
  // because the worker (catalogWorker.ts) only ever processes one item at a
  // time, globally, across every batch.
  duplicateAlbumMap Json?

  // The admin's explicit "Regular Album" vs "Concert Album" destination
  // choice for this whole batch (see routes/youtubeCatalogImport.ts) —
  // applied only to albums *newly created* while processing this batch
  // (catalogWorker.ts/pipeline.ts's findOrCreateAlbum); an album this batch
  // merely matches by title keeps whatever type it already had, so choosing
  // "Concert Album" here can never silently retag an existing regular album.
  albumType AlbumType @default(album)

  @@index([createdBy])
}

// What entity kind a FeaturedBanner points at. Only "album" is wired up to
// an actual admin flow today — the others exist so the Home hero carousel's
// architecture (one polymorphic collection, entityType + entityId) never has
// to change shape to support them later, only the resolver + admin picker.
enum FeaturedBannerEntityType {
  album
  single
  artist
  playlist
  concert
}

// A hand-curated slot in the Home screen's top hero carousel. Deliberately
// NOT a field on Album (or any other entity) — the carousel is a fully
// separate, admin-curated collection that merely *references* an existing
// album (etc.) by id, so featuring/unfeaturing something never touches the
// entity itself and normal album artwork (cover, "New Releases", "Albums",
// Now Playing, ...) is never affected by what's in here.
model FeaturedBanner {
  id         String                   @id @default(cuid())
  entityType FeaturedBannerEntityType @default(album)
  entityId   String

  // Independent from the entity's own artwork (e.g. Album.coverUrl) — null
  // means "no custom banner image set", in which case callers fall back to
  // the entity's own cover image at render time.
  bannerImageUrl String?

  // Optional overrides of the entity's own display fields — null means "use
  // the entity's own title/artist name" at render time.
  title      String?
  subtitle   String?
  badgeText  String?
  buttonText String?

  displayOrder Int     @default(0)
  enabled      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([enabled, displayOrder])
  @@map("featured_banners")
}

model YoutubeImportItem {
  id           String                  @id @default(cuid())
  batchId      String
  batch        YoutubeImportBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  videoId      String
  title        String
  albumTitle   String?
  position     Int
  thumbnailUrl String?
  duration     Int?
  selected     Boolean                 @default(false)
  status       YoutubeImportItemStatus @default(pending)
  progress     Int                     @default(0)
  message      String?
  error        String?
  trackId      String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  // Set once this item finishes processing (success or skipped-duplicate),
  // used only to compute the import summary — see YoutubeCatalogImport.tsx.
  // trackWasNew: true if a new Track row was created, false if it matched
  // an existing one (sourceId or fuzzy title) and was skipped.
  // albumWasNew: for album items only — whether this item's albumTitle was
  // absent from the batch's existingAlbumTitlesSnapshot; null for singles.
  trackWasNew Boolean?
  albumWasNew Boolean?

  @@unique([batchId, videoId])
  @@index([batchId])
}

enum TelegramImportBatchStatus {
  enumerating
  ready
  importing
  // Admin manually stopped an in-progress batch — mirrors
  // YoutubeImportBatchStatus.stopped.
  stopped
  completed
  completed_with_errors
  error
}

enum TelegramImportItemStatus {
  pending // enumerated, not yet selected
  selected // chosen by the admin, queued for processing
  downloading
  processing // waveform generation
  uploading
  saving
  done
  error
  skipped_duplicate
  // Admin manually cancelled this one item — mirrors
  // YoutubeImportItemStatus.cancelled.
  cancelled
}

// One "Import from Telegram channel" run against a single channel link.
// Deliberately parallel to YoutubeImportBatch/YoutubeImportItem rather than
// generalizing those existing models — a Telegram channel has no
// Releases/Playlists to auto-detect album grouping from (unlike YouTube), so
// every item enumerated here starts with albumTitle: null and the admin
// assigns it explicitly (see routes/telegramImport.ts's /assign-album) before
// starting the import, rather than it being detected up front.
model TelegramImportBatch {
  id          String                    @id @default(cuid())
  sourceUrl   String
  channelName String?
  status      TelegramImportBatchStatus @default(enumerating)
  error       String?
  createdBy   String                    @db.Uuid
  admin       Profile                   @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  items       TelegramImportItem[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  // Purely cosmetic, admin-editable display name for the Import History
  // list — never read or written by the pipeline itself.
  label String?

  // The artist this whole batch imports into — chosen explicitly by the
  // admin before enumeration starts (never guessed from the channel name).
  targetArtistId String?

  // Normalized titles of albums that already existed under targetArtistId at
  // the moment this batch was created — see YoutubeImportBatch's field of
  // the same name for why this is a snapshot rather than a live check.
  existingAlbumTitlesSnapshot Json?

  // "Allow duplicate imports" — off by default (skip anything that already
  // exists). See YoutubeImportBatch.allowDuplicates.
  allowDuplicates Boolean @default(false)

  // Maps a normalized album title to the id of the new duplicate Album
  // created for it *during this batch run* — see YoutubeImportBatch's field
  // of the same name.
  duplicateAlbumMap Json?

  @@index([createdBy])
}

model TelegramImportItem {
  id           String                   @id @default(cuid())
  batchId      String
  batch        TelegramImportBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  // Telegram message id of the audio post, scoped to the channel — combined
  // with the channel id to form the Track.sourceId this import writes
  // (`tg:<channelId>:<messageId>`), so a message id alone is only unique
  // within this batch's own channel, not globally.
  messageId    String
  title        String
  // Telegram's own DocumentAttributeAudio.performer tag, if the uploader set
  // one — shown for reference only, never used for artist resolution (the
  // admin's explicit artist choice for the whole batch always wins).
  performer    String?
  // Null until the admin explicitly assigns it via /assign-album — unlike
  // YoutubeImportItem, never auto-populated at enumeration time (see the
  // TelegramImportBatch doc comment for why).
  albumTitle   String?
  position     Int
  thumbnailUrl String?
  duration     Int?
  selected     Boolean                  @default(false)
  status       TelegramImportItemStatus @default(pending)
  progress     Int                      @default(0)
  message      String?
  error        String?
  trackId      String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  // See YoutubeImportItem's fields of the same name.
  trackWasNew Boolean?
  albumWasNew Boolean?

  @@unique([batchId, messageId])
  @@index([batchId])
}
